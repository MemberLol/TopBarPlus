local realRequire = require
local loaders = {}
local results = {}
local loadedFlags = {}

local root = Instance.new("Folder")
root.Name = "topbarplus"

local function node(path)
  local current = root
  for part in string.gmatch(path, "[^%.]+") do
    local child = current:FindFirstChild(part)
    if not child then
      child = Instance.new("Folder")
      child.Name = part
      child.Parent = current
    end
    current = child
  end
  return current
end

local function customRequire(target)
  local loader = loaders[target]
  if not loader then
    return realRequire(target)
  end
  if not loadedFlags[target] then
    local value = loader(target, customRequire)
    results[target] = value
    loadedFlags[target] = true
  end
  return results[target]
end

local function define(path, fn)
  loaders[node(path)] = fn
end

