-- Remove shadow ImageLabels left behind by previously loaded copies of TopbarPlus.
-- This intentionally runs BEFORE the cached-library early return below, because
-- cached captions can keep their old shadow objects even after Library7 is updated.
local legacyShadowName = "Drop" .. "Shadow"
local function removeLegacyCaptionShadows(root)
  if not root then
    return
  end

  local descendants
  local ok = pcall(function()
    descendants = root:GetDescendants()
  end)
  if not ok or not descendants then
    return
  end

  for _, instance in ipairs(descendants) do
    if instance:IsA("ImageLabel") and instance.Name == legacyShadowName then
      local ancestor = instance.Parent
      while ancestor and ancestor.Name ~= "Caption" do
        ancestor = ancestor.Parent
      end
      if ancestor then
        pcall(function()
          instance:Destroy()
        end)
      end
    end
  end
end

